// Nextflow configuration file
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'

        process {

            withLabel: process_medium {
                cpus = 4
                memory = '12 GB'
                time = '2h'
            }
        }
    }
}

// Default profile
params {
    reads = "../../../data/reads/ont/ecoli_ERR10499031.fastq.gz"
    reference = "../../../data/reads/ont/ecoli_ERR10499031.flye.fa.gz"
    preset = "map-ont"
    mode = "bam"
}
