// Nextflow configuration file
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'

        process {

            withLabel: process_medium {
                cpus = 4
                memory = '12 GB'
                time = '4h'
            }
        }
    }
}

// Default profile
// Note: `db` must be supplied at runtime: --db /path/to/kofam_serialized.pkl
params {
    fasta = "../../../data/organisms/bacteria/e_coli.faa.gz"
    db = "/path/to/kofam_serialized.pkl"
    write_reformatted_output = true
    is_serialized_database = true
}
