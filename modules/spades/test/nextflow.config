// Nextflow configuration file
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'

        process {

            withLabel: process_high {
                cpus = 4
                memory = '16 GB'
                time = '4h'
            }
        }
    }
}

// Default profile
params {
    r1 = "../../../data/reads/illumina/toy_plastisphere/S1_1.fastq.gz"
    r2 = "../../../data/reads/illumina/toy_plastisphere/S1_2.fastq.gz"
    program = "metaspades.py"
}
